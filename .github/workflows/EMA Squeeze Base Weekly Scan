name: EMA Squeeze Base Scanner

on:
  schedule:
    # Monday + Friday, 18:00 IST = 12:30 UTC
    - cron: '30 12 * * 1,5'
  workflow_dispatch: {}

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

     - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          # Removed cache: 'pip' to prevent missing requirements.txt error

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install yfinance pandas numpy ta requests

      - name: Run EMA Squeeze Base Scanner
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: |
          python EMA Squeeze Base Scanner.py

      - name: Commit and push match history
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add match_history.csv || true
          git commit -m "Auto-update match history [skip ci]" || echo "No changes to commit"
          git push || echo "Push skipped"
